# Konfigurasi Port
PORT=7033

# Kredensial Aplikasi
JWT_SECRET="RAHASIA_SUPER_DUPER_PENTING_GANTI_INI"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="password123" # Ganti dengan password yang kuat

# Kredensial Google OAuth 2.0
# Dapatkan dari Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="MASUKKAN_CLIENT_ID_ANDA"
GOOGLE_CLIENT_SECRET="MASUKKAN_CLIENT_SECRET_ANDA"
GOOGLE_REDIRECT_URI="http://localhost:7033/api/auth/google/callback"

# URL Koneksi Database PostgreSQL
# Contoh: DATABASE_URL="postgresql://user:password@localhost:5432/mydatabase"
DATABASE_URL="MASUKKAN_URL_DATABASE_ANDA"